<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许局域网 HTTP 明文传输（用于手机直接连接电脑端 http://<PC_LAN_IP>:8000） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
